datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Pengguna / Toko
model User {
  id            BigInt    @id @default(autoincrement())
  name          String    @db.VarChar(100)
  email         String    @unique @db.VarChar(150)
  passwordHash  String?   @map("password_hash") @db.VarChar(255)
  googleId      String?   @map("google_id") @db.VarChar(100)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  licenses      License[]

  @@map("users")
}

// 2. Pesanan Lisensi
model Order {
  id                 BigInt    @id @default(autoincrement())
  orderNumber        String    @unique @map("order_number") @db.VarChar(50)
  customerName       String    @map("customer_name") @db.VarChar(100)
  customerEmail      String    @map("customer_email") @db.VarChar(150)
  customerWhatsapp   String?   @map("customer_whatsapp") @db.VarChar(30)
  packageName        String    @default("LIFETIME_TIER") @map("package_name") @db.VarChar(50)
  amount             Int
  paymentStatus      String    @default("PENDING") @map("payment_status") @db.VarChar(20)
  paymentGateway     String    @map("payment_gateway") @db.VarChar(30)
  paymentReference   String?   @map("payment_reference") @db.VarChar(100)
  paidAt             DateTime? @map("paid_at") @db.Timestamptz()
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  license            License?

  @@map("orders")
}

// 3. Lisensi Ekstensi Chrome
model License {
  id               BigInt    @id @default(autoincrement())
  orderId          BigInt    @unique @map("order_id")
  userId           BigInt?   @map("user_id")
  licenseKey       String    @unique @map("license_key") @db.VarChar(64)
  status           String    @default("INACTIVE") @db.VarChar(20)
  deviceIdentifier String?   @map("device_identifier") @db.VarChar(255)
  activatedAt      DateTime? @map("activated_at") @db.Timestamptz()
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("licenses")
}

// 4. Prospek / Leads Waitlist
model LeadsWaitlist {
  id             BigInt   @id @default(autoincrement())
  email          String   @unique @db.VarChar(150)
  phoneNumber    String?  @map("phone_number") @db.VarChar(30)
  utmSource      String?  @default("organic_landing") @map("utm_source") @db.VarChar(50)
  isContacted    Boolean  @default(false) @map("is_contacted")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("leads_waitlist")
}

// 5. Rate Limit Simulator Demo
model DemoRateLimit {
  ipAddress     String   @id @map("ip_address") @db.VarChar(45)
  requestCount  Int      @default(1) @map("request_count")
  lastAttemptAt DateTime @default(now()) @updatedAt @map("last_attempt_at") @db.Timestamptz()

  @@map("demo_rate_limits")
}